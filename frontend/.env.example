# Supabase project URL. Example: https://your-project-ref.supabase.co
VITE_SUPABASE_URL=
# Publishable client key from Project Settings > API Keys. Not the service-role key.
VITE_SUPABASE_PUBLISHABLE_KEY=
# Portfolio calls use /api. Account calls use /api/v1. Either base is accepted.
VITE_API_BASE_URL=http://localhost:8080/api/v1
# false keeps the desk on the API. true falls back to the sample portfolio when the API is down.
VITE_DEMO_MODE=false
